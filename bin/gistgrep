#!/usr/bin/env python3
"""gistgrep: fast local search over your GitHub gists.

Mirrors your gists to ~/.cache/gistgrep/, auto-syncs on each run via a
cheap 1-call freshness check, and ranks matches by
title > filename > body, with a recency boost.

By default drops into an interactive fzf TUI with a live preview pane.
Pipes and --plain fall back to plain-text output.

Usage:
  gistgrep                  # interactive TUI
  gistgrep <query>          # interactive, pre-filtered
  gistgrep --plain <q>      # plain-text list (scriptable)
  gistgrep --json <q>       # JSON results (for launchers and other UIs)
  gistgrep --sync           # force full resync
  gistgrep --sync-only      # bring the cache up to date, then exit
  gistgrep --no-sync <q>    # search cached only (no network, no gh)
  gistgrep --limit 50 <q>

Every word of the query must match somewhere in the gist.

Interactive bindings:
  Enter    open gist in browser
  Ctrl-Y   copy gist URL to clipboard
  Ctrl-E   open cached copy in $EDITOR
  Esc      quit
"""
import argparse
import json
import os
import platform
import re
import select
import shutil
import subprocess
import sys
import termios
import threading
import time
import tty
import urllib.request
from datetime import datetime, timezone
from pathlib import Path

CANCELLED = threading.Event()
_CURRENT_SUBPROC = None  # tracked for Esc-kill

# GISTGREP_CACHE points gistgrep at another cache (tests, a second account).
CACHE_OVERRIDDEN = bool(os.environ.get("GISTGREP_CACHE"))
CACHE = Path(os.path.expanduser(os.environ.get("GISTGREP_CACHE") or "~/.cache/gistgrep"))
GISTS = CACHE / "gists"
STATE = CACHE / "state.json"
APPLE_LLM_BIN = CACHE / "apple-llm"
APPLE_LLM_SRC = CACHE / "apple-llm.swift"
SUMMARIZE_LOCK = CACHE / "summarize.lock"
RECONCILE_INTERVAL = 7 * 86400
RECONCILE_WINDOW = 100
LLM_RECHECK_INTERVAL = 86400            # re-probe an "unavailable" model daily
SUMMARY_RETRY_INTERVAL = 7 * 86400      # retry a failed summary weekly, not every run
SUMMARY_MAX_FILE_CHARS = 2000
SUMMARY_MAX_TOTAL_CHARS = 8000
SUMMARY_TIMEOUT = 60


def _migrate_legacy_cache():
    """One-time migration from the previous ~/.cache/gist-search path."""
    legacy = Path(os.path.expanduser("~/.cache/gist-search"))
    if CACHE_OVERRIDDEN:
        return
    if legacy.exists() and not CACHE.exists():
        try:
            legacy.rename(CACHE)
            print(f"gistgrep: migrated cache from {legacy} → {CACHE}", file=sys.stderr)
        except OSError:
            pass


_migrate_legacy_cache()


APPLE_LLM_SWIFT = r"""
import Foundation
import FoundationModels

@main
struct AppleLLM {
    static func main() async {
        let data = FileHandle.standardInput.readDataToEndOfFile()
        guard let prompt = String(data: data, encoding: .utf8) else {
            FileHandle.standardError.write("error: invalid utf-8 on stdin\n".data(using: .utf8)!)
            exit(2)
        }
        switch SystemLanguageModel.default.availability {
        case .available:
            break
        case .unavailable(let reason):
            FileHandle.standardError.write("unavailable: \(reason)\n".data(using: .utf8)!)
            exit(3)
        }
        do {
            let session = LanguageModelSession()
            let response = try await session.respond(to: prompt)
            print(response.content)
        } catch {
            FileHandle.standardError.write("error: \(error)\n".data(using: .utf8)!)
            exit(1)
        }
    }
}
"""


class LLMUnavailable(Exception):
    """The on-device model is switched off or missing (helper exit code 3)."""


def mark_llm_unavailable(state, reason, compile_failed=False):
    fields = {
        "apple_llm_status": "unavailable",
        "apple_llm_reason": reason,
        "apple_llm_checked_at": int(time.time()),
    }
    if compile_failed:
        # Don't re-run a 2-minute compile daily on a macOS that can't build it;
        # an OS upgrade (new version string) tries again.
        fields["apple_llm_compile_failed_on"] = platform.mac_ver()[0]
    update_state(state, **fields)
    return False, reason


def compile_failed_on_this_os(state):
    return (not APPLE_LLM_BIN.exists()
            and state.get("apple_llm_compile_failed_on") == platform.mac_ver()[0])


def forget_llm_status(state):
    """--check-llm / --doctor: forget the cached answer and probe now."""
    update_state(state, apple_llm_status=None, apple_llm_reason=None,
                 apple_llm_compile_failed_on=None)


def llm_check_due(state):
    return time.time() - state.get("apple_llm_checked_at", 0) >= LLM_RECHECK_INTERVAL


def ensure_apple_llm(state):
    """Compile the Swift helper on first use. Returns (available, reason).

    The cached answer is re-checked once a day either way, so switching Apple
    Intelligence on (or off) in System Settings is noticed without --check-llm."""
    status = state.get("apple_llm_status")
    if status == "unavailable" and (not llm_check_due(state) or compile_failed_on_this_os(state)):
        return False, state.get("apple_llm_reason", "previously unavailable")
    if status == "available" and APPLE_LLM_BIN.exists() and not llm_check_due(state):
        return True, None
    if sys.platform != "darwin":
        return mark_llm_unavailable(state, "not macOS")
    if not APPLE_LLM_BIN.exists():
        if not shutil.which("swiftc"):
            return mark_llm_unavailable(state, "swiftc not found (install Xcode CLI tools)")
        CACHE.mkdir(parents=True, exist_ok=True)
        APPLE_LLM_SRC.write_text(APPLE_LLM_SWIFT)
        try:
            subprocess.run(
                ["swiftc", "-O", "-parse-as-library", str(APPLE_LLM_SRC), "-o", str(APPLE_LLM_BIN)],
                capture_output=True, text=True, check=True, timeout=120,
            )
        except subprocess.CalledProcessError as e:
            return mark_llm_unavailable(state, f"compile failed: {e.stderr.strip()[:200]}",
                                        compile_failed=True)
        except subprocess.TimeoutExpired:
            return mark_llm_unavailable(state, "swiftc timed out")
    # Smoke test
    try:
        r = subprocess.run(
            [str(APPLE_LLM_BIN)], input="Say OK", capture_output=True, text=True, timeout=30,
        )
        if r.returncode != 0:
            msg = (r.stderr or "").strip().splitlines()[0] if r.stderr else f"exit {r.returncode}"
            return mark_llm_unavailable(state, msg[:200])
    except subprocess.TimeoutExpired:
        return mark_llm_unavailable(state, "smoke test timed out")
    now = int(time.time())
    fields = {"apple_llm_status": "available", "apple_llm_reason": None,
              "apple_llm_checked_at": now}
    if state.get("apple_llm_status") != "available":
        # The model just came (back) on: summaries that failed before now may
        # have failed only because it was off, so they get one retry at once.
        fields["apple_llm_available_since"] = now
    update_state(state, **fields)
    return True, None


def run_apple_llm(prompt, timeout=SUMMARY_TIMEOUT):
    """The model's reply, or None if this prompt failed. Raises LLMUnavailable
    when the model itself is off, so callers stop instead of failing every gist."""
    try:
        r = subprocess.run(
            [str(APPLE_LLM_BIN)],
            input=prompt,
            capture_output=True,
            text=True,
            timeout=timeout,
        )
        if r.returncode == 3:
            raise LLMUnavailable((r.stderr or "").strip()[:200] or "unavailable")
        if r.returncode != 0:
            return None
        return r.stdout.strip()
    except subprocess.TimeoutExpired:
        return None


class Cancelled(Exception):
    pass


def _run_gh(cmd):
    global _CURRENT_SUBPROC
    if CANCELLED.is_set():
        raise Cancelled()
    proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    _CURRENT_SUBPROC = proc
    try:
        out, err = proc.communicate()
    finally:
        _CURRENT_SUBPROC = None
    if CANCELLED.is_set():
        raise Cancelled()
    if proc.returncode != 0:
        raise subprocess.CalledProcessError(proc.returncode, cmd, out, err)
    return out


def gh_api(path):
    return json.loads(_run_gh(["gh", "api", path]))


def gh_api_paginated(path):
    return json.loads(_run_gh(["gh", "api", "--paginate", path]))


class SyncStatus:
    """Print a transient status line while sync runs; Esc cancels. No-op off TTY."""
    def __init__(self, message="↻ Checking for new gists…  (Esc to skip)"):
        self.message = message
        self.active = False
        self.stop = threading.Event()

    def __enter__(self):
        if not (sys.stderr.isatty() and sys.stdin.isatty()):
            return self
        try:
            self.fd = sys.stdin.fileno()
            self.old_attrs = termios.tcgetattr(self.fd)
            tty.setcbreak(self.fd)
        except (termios.error, OSError):
            return self
        self.active = True
        sys.stderr.write(f"\r\033[2m{self.message}\033[0m")
        sys.stderr.flush()
        self.thread = threading.Thread(target=self._watch, daemon=True)
        self.thread.start()
        return self

    def _watch(self):
        while not self.stop.is_set():
            try:
                r, _, _ = select.select([sys.stdin], [], [], 0.1)
            except (OSError, ValueError):
                return
            if r:
                try:
                    ch = sys.stdin.read(1)
                except (OSError, ValueError):
                    return
                if ch == "\x1b":  # Esc
                    CANCELLED.set()
                    proc = _CURRENT_SUBPROC
                    if proc is not None:
                        try:
                            proc.kill()
                        except ProcessLookupError:
                            pass
                    return

    def __exit__(self, *exc):
        self.stop.set()
        if not self.active:
            return
        try:
            termios.tcsetattr(self.fd, termios.TCSADRAIN, self.old_attrs)
        except (termios.error, OSError):
            pass
        # Clear the status line
        sys.stderr.write("\r\033[2K")
        sys.stderr.flush()


def load_state():
    if STATE.exists():
        try:
            return json.loads(STATE.read_text())
        except json.JSONDecodeError:
            pass
    return {"last_updated_at": None, "last_reconcile": 0}


def save_state(s):
    """Atomic: a reader never sees a half-written file, which would read as
    "never synced" and trigger a full resync."""
    CACHE.mkdir(parents=True, exist_ok=True)
    tmp = STATE.with_name(f"{STATE.name}.{os.getpid()}.tmp")
    tmp.write_text(json.dumps(s, indent=2))
    os.replace(tmp, STATE)


def update_state(state, **fields):
    """Write only `fields`, merged into what is on disk now, so concurrent
    gistgrep processes (a foreground sync, the background workers) don't
    revert each other's keys. Also updates the caller's `state` dict."""
    fresh = load_state()
    fresh.update(fields)
    save_state(fresh)
    state.update(fields)


def safe_name(name):
    return name.replace("/", "_").replace("\0", "_")


def save_gist(g):
    d = GISTS / g["id"]
    d.mkdir(parents=True, exist_ok=True)
    meta = {
        "id": g["id"],
        "description": g.get("description") or "",
        "updated_at": g["updated_at"],
        "html_url": g["html_url"],
        "public": g.get("public", False),
        "files": list(g.get("files", {}).keys()),
    }
    # Invalidate stale summary when the gist has changed
    prev_meta_path = d / "_meta.json"
    summary_path = d / "_summary.json"
    if prev_meta_path.exists() and summary_path.exists():
        try:
            prev = json.loads(prev_meta_path.read_text())
            if prev.get("updated_at") != meta["updated_at"]:
                summary_path.unlink()
        except (json.JSONDecodeError, OSError):
            pass
    (d / "_meta.json").write_text(json.dumps(meta, indent=2))
    for name, f in g.get("files", {}).items():
        content = f.get("content") or ""
        # The /gists LIST endpoint omits content entirely; individual fetch may
        # truncate large files. Either way: if content is missing or truncated,
        # fetch from raw_url (works for secret gists via unguessable URL).
        if (not content or f.get("truncated")) and f.get("raw_url"):
            try:
                with urllib.request.urlopen(f["raw_url"], timeout=30) as resp:
                    content = resp.read().decode("utf-8", "replace")
            except Exception as e:
                print(
                    f"gistgrep: warn: failed to fetch {name} of {g['id']}: {e}",
                    file=sys.stderr,
                )
        try:
            (d / safe_name(name)).write_text(content, errors="replace")
        except OSError as e:
            print(
                f"gistgrep: warn: failed to write {name} of {g['id']}: {e}",
                file=sys.stderr,
            )


def remote_max_updated_at():
    latest = gh_api("/gists?per_page=1")
    return latest[0]["updated_at"] if latest else None


def needs_sync(state):
    """One-call freshness check. Raises CalledProcessError when GitHub can't be reached."""
    remote_max = remote_max_updated_at()
    return remote_max != state.get("last_updated_at"), remote_max


def sync(since=None):
    path = "/gists?per_page=100"
    if since:
        path = f"/gists?since={since}&per_page=100"
    gists = gh_api_paginated(path)
    for g in gists:
        save_gist(g)
    return len(gists)


def reconcile_bg():
    subprocess.Popen(
        [sys.executable, str(Path(__file__).resolve()), "--reconcile"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )


def summarize_bg():
    subprocess.Popen(
        [sys.executable, str(Path(__file__).resolve()), "--summarize-queue"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )


def sync_now(state, full=False):
    """Bring the local mirror up to date. Returns a status message, or None if
    nothing changed. Raises CalledProcessError (or Cancelled) on failure."""
    if full:
        n = sync(None)
        update_state(state, last_updated_at=remote_max_updated_at())
        return f"full sync: {n} gists"
    if state.get("last_updated_at") is None:
        n = sync(None)
        update_state(state, last_updated_at=remote_max_updated_at())
        return f"initial sync: {n} gists"
    changed, remote_max = needs_sync(state)
    if changed and remote_max:
        n = sync(state["last_updated_at"])
        update_state(state, last_updated_at=remote_max)
        return f"{n} updated"
    return None


def start_upkeep(state):
    """Background housekeeping that follows a sync: prune deleted gists weekly and
    summarize anything new. Never runs on a cache-only (--no-sync) search."""
    if time.time() - state.get("last_reconcile", 0) > RECONCILE_INTERVAL:
        reconcile_bg()
    # The worker also runs the daily model re-check, so start it when one is due.
    if state.get("apple_llm_status") != "unavailable" or (
            llm_check_due(state) and not compile_failed_on_this_os(state)):
        summarize_bg()


def build_summary_prompt(meta, files_content):
    # Keep prompt tight so LLM output stays well under its token cap
    max_files = 5
    items = list(files_content.items())[:max_files]
    filenames = [fn for fn, _ in items]
    example_files = ", ".join(f'"{fn}": "purpose of this file"' for fn in filenames[:2])
    parts = [
        "You are summarizing a GitHub gist for a preview UI. Be terse and factual.",
        "",
        "Output ONLY a JSON object, one line, no markdown fences, no prose before or after.",
        "The 'summary' field is <=80 chars describing the gist overall.",
        "The 'files' object maps EACH filename below to a <=60 char description of what that file contains.",
        f"Use these exact filename keys: {filenames}",
        "",
        "Example output format (do not copy its content, only its shape):",
        '{"summary":"Script backing up gists to S3","files":{' + example_files + "}}",
        "",
        f'Gist description: {meta["description"] or "(none)"}',
        "",
    ]
    total = 0
    per_file_budget = max(400, SUMMARY_MAX_TOTAL_CHARS // max(1, len(items)))
    for fn, content in items:
        snippet = content[:per_file_budget]
        if total + len(snippet) > SUMMARY_MAX_TOTAL_CHARS:
            snippet = snippet[: max(0, SUMMARY_MAX_TOTAL_CHARS - total)]
        total += len(snippet)
        parts.append(f"--- {fn} ---")
        parts.append(snippet if snippet else "(empty)")
        parts.append("")
        if total >= SUMMARY_MAX_TOTAL_CHARS:
            break
    return "\n".join(parts)


_SUMMARY_RE = re.compile(r'"summary"\s*:\s*"((?:[^"\\]|\\.)*)"')
_FILE_ITEM_RE = re.compile(r'"((?:[^"\\]|\\.)+)"\s*:\s*"((?:[^"\\]|\\.)*)"')


def parse_summary_json(raw):
    """Parse LLM output. If truncated, salvage the summary and any complete file entries."""
    if not raw:
        return None
    s = raw.strip()
    if s.startswith("```"):
        s = s.strip("`")
        if s.startswith("json\n"):
            s = s[5:]
    # Attempt 1: direct JSON
    try:
        return json.loads(s)
    except json.JSONDecodeError:
        pass
    # Attempt 2: find {...} substring
    start = s.find("{")
    end = s.rfind("}")
    if start >= 0 and end > start:
        try:
            return json.loads(s[start : end + 1])
        except json.JSONDecodeError:
            pass
    # Attempt 3: salvage from truncated output
    m = _SUMMARY_RE.search(s)
    if not m:
        return None
    summary = m.group(1).encode().decode("unicode_escape", errors="replace")
    files = {}
    # Look for "files": { ... } region and extract complete pairs within it
    files_start = s.find('"files"')
    if files_start >= 0:
        brace = s.find("{", files_start)
        if brace >= 0:
            region = s[brace:]
            # Pull complete key:value pairs; ignore the outer "summary" field if it was before
            for fm in _FILE_ITEM_RE.finditer(region):
                k = fm.group(1).encode().decode("unicode_escape", errors="replace")
                v = fm.group(2).encode().decode("unicode_escape", errors="replace")
                if k == "summary":
                    continue
                files[k] = v
    return {"summary": summary, "files": files, "_salvaged": True}


def summarize_gist(gist_id):
    d = GISTS / gist_id
    meta_file = d / "_meta.json"
    if not meta_file.exists():
        return False
    meta = json.loads(meta_file.read_text())
    files_content = {}
    for fn in meta["files"]:
        p = d / safe_name(fn)
        if p.exists():
            try:
                files_content[fn] = p.read_text(errors="replace")
            except OSError:
                files_content[fn] = ""
        else:
            files_content[fn] = ""
    prompt = build_summary_prompt(meta, files_content)
    raw = run_apple_llm(prompt)
    parsed = parse_summary_json(raw)
    if not isinstance(parsed, dict):
        parsed = None                   # valid JSON but not an object: treat as unparsed
    if not parsed:
        # Store raw fallback so we don't re-attempt forever; user sees it anyway.
        parsed = {"summary": (raw or "")[:120], "files": {}, "_unparsed": True}
    if not parsed.get("summary"):
        parsed["_unparsed"] = True      # nothing usable: show "failed", retry weekly
    parsed["generated_at"] = datetime.now(timezone.utc).isoformat(timespec="seconds")
    parsed["updated_at"] = meta["updated_at"]
    (d / "_summary.json").write_text(json.dumps(parsed, indent=2))
    return True


def summary_retry_due(summ, available_since=None):
    """A failed summary is retried weekly — an unconditional retry re-ran the
    model over every failed gist on every invocation — and once straight away
    if it failed before the model last came on (it may have been off)."""
    try:
        generated = datetime.fromisoformat(summ.get("generated_at") or "")
    except (TypeError, ValueError):
        return True
    if generated.tzinfo is None:
        generated = generated.replace(tzinfo=timezone.utc)
    if available_since and generated.timestamp() < available_since:
        return True
    return (datetime.now(timezone.utc) - generated).total_seconds() > SUMMARY_RETRY_INTERVAL


def summarize_queue():
    """Background worker: summarize any gist missing a fresh summary. Single-instance.
    The lock comes first, so two workers never compile the helper at once."""
    # Single-instance lock — check PID, not age (process may die unexpectedly)
    def acquire():
        return os.open(str(SUMMARIZE_LOCK), os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o644)

    try:
        fd = acquire()
    except FileExistsError:
        try:
            pid_str = SUMMARIZE_LOCK.read_text().strip()
            pid = int(pid_str) if pid_str.isdigit() else 0
            alive = False
            if pid > 0:
                try:
                    os.kill(pid, 0)
                    alive = True
                except ProcessLookupError:
                    alive = False
                except PermissionError:
                    alive = True
            if alive:
                return
            SUMMARIZE_LOCK.unlink()
            fd = acquire()
        except (FileNotFoundError, OSError, ValueError):
            return
    try:
        os.write(fd, f"{os.getpid()}\n".encode())
        os.close(fd)
        state = load_state()
        available, _ = ensure_apple_llm(state)
        if not available or not GISTS.exists():
            return
        available_since = state.get("apple_llm_available_since")
        for d in sorted(GISTS.iterdir(), key=lambda p: p.stat().st_mtime, reverse=True):
            meta_file = d / "_meta.json"
            summary_file = d / "_summary.json"
            if not meta_file.exists():
                continue
            needs = True
            if summary_file.exists():
                try:
                    meta = json.loads(meta_file.read_text())
                    summ = json.loads(summary_file.read_text())
                    if summ.get("updated_at") == meta["updated_at"]:
                        needs = (bool(summ.get("_unparsed"))
                                 and summary_retry_due(summ, available_since))
                except (json.JSONDecodeError, OSError):
                    pass
            if needs:
                try:
                    summarize_gist(d.name)
                except LLMUnavailable as e:
                    # The model is off: record that once and stop, rather than
                    # writing an empty "failed" summary for every remaining gist.
                    mark_llm_unavailable(load_state(), str(e))
                    return
    finally:
        try:
            SUMMARIZE_LOCK.unlink()
        except FileNotFoundError:
            pass


def do_reconcile():
    try:
        recent = gh_api(f"/gists?per_page={RECONCILE_WINDOW}")
    except subprocess.CalledProcessError:
        return
    if not recent:
        return
    recent_ids = {g["id"] for g in recent}
    oldest = min(g["updated_at"] for g in recent)
    removed = 0
    if GISTS.exists():
        for d in GISTS.iterdir():
            meta_file = d / "_meta.json"
            if not meta_file.exists():
                continue
            try:
                meta = json.loads(meta_file.read_text())
            except json.JSONDecodeError:
                continue
            if meta["updated_at"] >= oldest and meta["id"] not in recent_ids:
                shutil.rmtree(d, ignore_errors=True)
                removed += 1
    update_state({}, last_reconcile=int(time.time()))


def query_terms(query):
    return query.lower().split()


BODY_HITS_CAP = 9  # per word: less than one title match (×10), so a long file can't tie one


def score(query, meta, body_text):
    """Every word of the query must match the title, a filename or the body.
    Each word scores title ×10, filename ×5, body ×1 per match (at most
    BODY_HITS_CAP per word); a title that contains the whole phrase scores it
    again as one more title match. `hits` reports the raw counts."""
    terms = query_terms(query)
    if not terms:
        return 0.0, []
    desc = meta["description"].lower()
    filenames = [fn.lower() for fn in meta["files"]]
    body = body_text.lower()
    title_hits = file_hits = body_hits = body_scored = phrase_hits = 0
    for t in terms:
        t_title = desc.count(t)
        t_file = sum(1 for fn in filenames if t in fn)
        t_body = body.count(t)
        if not (t_title or t_file or t_body):
            return 0.0, []
        title_hits += t_title
        file_hits += t_file
        body_hits += t_body
        body_scored += min(t_body, BODY_HITS_CAP)
    if len(terms) > 1:
        phrase_hits = desc.count(" ".join(terms))
    s = 10.0 * (title_hits + phrase_hits) + 5.0 * file_hits + 1.0 * body_scored
    hits = []
    if title_hits:
        hits.append(f"title×{title_hits}")
    if file_hits:
        hits.append(f"file×{file_hits}")
    if body_hits:
        hits.append(f"body×{body_hits}")
    try:
        updated = datetime.fromisoformat(meta["updated_at"].replace("Z", "+00:00"))
        age_days = (datetime.now(timezone.utc) - updated).days
    except Exception:
        age_days = 9999
    # Recency boost: up to +5 for very recent, decaying over ~180 days
    s += max(0.0, 5.0 * (1.0 - min(age_days, 180) / 180.0))
    return s, hits


def load_body(d, meta):
    parts = []
    for fn in meta["files"]:
        p = d / safe_name(fn)
        if p.exists():
            try:
                parts.append(p.read_text(errors="replace"))
            except OSError:
                pass
    return "\n".join(parts)


def search(query, limit=20):
    results = []
    if not GISTS.exists():
        return results
    for d in GISTS.iterdir():
        if not d.is_dir():
            continue
        meta_file = d / "_meta.json"
        if not meta_file.exists():
            continue
        try:
            meta = json.loads(meta_file.read_text())
        except json.JSONDecodeError:
            continue
        body = load_body(d, meta)
        sc, hits = score(query, meta, body)
        if sc > 0:
            results.append((sc, meta, hits))
    sort_results(results)
    return results[:limit]


def sort_results(results):
    """Score, then most recently updated, then id — the same order on every
    filesystem (directory listing order is not)."""
    results.sort(key=lambda x: x[1]["id"])
    results.sort(key=lambda x: x[1]["updated_at"], reverse=True)
    results.sort(key=lambda x: -x[0])


def recent(limit=20):
    """Every cached gist, most recently updated first (the no-query listing)."""
    results = []
    if not GISTS.exists():
        return results
    for d in GISTS.iterdir():
        meta_file = d / "_meta.json"
        if not meta_file.exists():
            continue
        try:
            meta = json.loads(meta_file.read_text())
        except json.JSONDecodeError:
            continue
        results.append((0.0, meta, []))
    sort_results(results)
    return results[:limit]


def load_summary(d):
    summary_file = d / "_summary.json"
    if not summary_file.exists():
        return None
    try:
        return json.loads(summary_file.read_text())
    except (json.JSONDecodeError, OSError):
        return None


def match_snippet(body_text, terms, width=140):
    """The body line that matches the most query words, trimmed around the
    first match. Empty when nothing in the body matches."""
    best_n, best_line = 0, ""
    for line in body_text.splitlines():
        low = line.lower()
        n = sum(1 for t in terms if t in low)
        if n > best_n:
            best_n, best_line = n, line.strip()
            if n == len(terms):
                break
    if not best_n:
        return ""
    if len(best_line) <= width:
        return best_line
    low = best_line.lower()
    first = min(low.find(t) for t in terms if t in low)
    start = max(0, first - width // 3)
    end = start + width
    return ("…" if start else "") + best_line[start:end] + ("…" if end < len(best_line) else "")


def result_json(sc, meta, hits, terms):
    d = GISTS / meta["id"]
    summary = load_summary(d) or {}
    return {
        "id": meta["id"],
        "description": meta["description"],
        "updated_at": meta["updated_at"],
        "html_url": meta["html_url"],
        "public": bool(meta.get("public")),
        "files": meta["files"],
        "score": round(sc, 2),
        "hits": hits,
        "summary": summary.get("summary") or None,
        "snippet": match_snippet(load_body(d, meta), terms) if terms else "",
    }


def fmt_json(results, query):
    terms = query_terms(query)
    print(json.dumps([result_json(sc, meta, hits, terms) for sc, meta, hits in results],
                     ensure_ascii=False))


def fmt_plain(results):
    if not results:
        print("No matches.")
        return
    for sc, meta, hits in results:
        desc = meta["description"] or "(no description)"
        files = ", ".join(meta["files"][:3])
        if len(meta["files"]) > 3:
            files += f", +{len(meta['files']) - 3}"
        marker = " " if meta.get("public") else "🔒"
        print(f"{marker} {meta['updated_at'][:10]}  {desc[:70]}")
        print(f"          {files}")
        print(f"          {meta['html_url']}")


def fzf_available():
    return shutil.which("fzf") is not None


def gh_available():
    if not shutil.which("gh"):
        return False, "gh not found (install: brew install gh)"
    r = subprocess.run(
        ["gh", "auth", "status"], capture_output=True, text=True
    )
    if r.returncode != 0:
        return False, "gh not authenticated (run: gh auth login)"
    return True, None


def doctor():
    print("gistgrep doctor")
    print("─" * 40)
    ok_gh, msg_gh = gh_available()
    print(f"  gh:                 {'✓' if ok_gh else '✗'} {msg_gh or 'authenticated'}")
    ok_fzf = fzf_available()
    print(f"  fzf:                {'✓' if ok_fzf else '✗'} {'installed' if ok_fzf else 'not found (install: brew install fzf) — TUI disabled'}")
    state = load_state()
    forget_llm_status(state)
    ok_llm, reason = ensure_apple_llm(state)
    if ok_llm:
        print("  Apple Intelligence: ✓ available (summaries enabled)")
    else:
        print(f"  Apple Intelligence: ⚠ unavailable — {reason} (search works, summaries disabled)")
    cache_size = sum(
        (p.stat().st_size for p in GISTS.rglob("*") if p.is_file()),
        0,
    ) if GISTS.exists() else 0
    gist_count = len([d for d in GISTS.iterdir() if d.is_dir()]) if GISTS.exists() else 0
    summary_count = len(list(GISTS.glob("*/_summary.json"))) if GISTS.exists() else 0
    print(f"  cache:              {gist_count} gists, {summary_count} summaries, {cache_size / 1024 / 1024:.1f} MB")
    print(f"                      {CACHE}")
    if not ok_gh:
        sys.exit(1)


def tui(results, initial_query=""):
    if not results:
        print("No matches.")
        return
    lines = []
    for sc, meta, hits in results:
        desc = (meta["description"] or "(no description)").replace("\t", " ")
        marker = " " if meta.get("public") else "🔒"
        lines.append(f"{meta['id']}\t{marker} {meta['updated_at'][:10]}  {desc[:80]}")
    self_path = str(Path(__file__).resolve())
    preview_cmd = f"{sys.executable} {self_path} --preview {{1}}"
    open_cmd = f"{sys.executable} {self_path} --open {{1}}"
    copy_cmd = f"{sys.executable} {self_path} --url {{1}} | pbcopy 2>/dev/null || {sys.executable} {self_path} --url {{1}} | xclip -selection clipboard 2>/dev/null"
    edit_cmd = f"{sys.executable} {self_path} --edit {{1}}"
    state = load_state()
    header = "Enter: open in browser  Ctrl-Y: copy URL  Ctrl-E: edit local copy"
    if state.get("apple_llm_status") == "unavailable":
        header = "⚠ summaries disabled — Apple Intelligence unavailable  │  " + header
    fzf_args = [
        "fzf",
        "--ansi",
        "--with-nth=2..",
        "--delimiter=\t",
        "--preview", preview_cmd,
        "--preview-window=right:60%:wrap",
        "--height=90%",
        "--reverse",
        "--header", header,
        "--bind", f"enter:become({open_cmd})",
        "--bind", f"ctrl-y:execute-silent({copy_cmd})+abort",
        "--bind", f"ctrl-e:execute({edit_cmd})",
    ]
    if initial_query:
        fzf_args += ["--query", initial_query]
    try:
        proc = subprocess.Popen(fzf_args, stdin=subprocess.PIPE, text=True)
        proc.communicate("\n".join(lines))
    except KeyboardInterrupt:
        pass


PREVIEW_TEASER_LINES = 20


def preview_data(gist_id):
    """Everything a preview shows, as plain data. None if the gist isn't cached."""
    d = GISTS / gist_id
    meta_file = d / "_meta.json"
    if not meta_file.exists():
        return None
    meta = json.loads(meta_file.read_text())
    summary = load_summary(d) or {}
    file_summaries = summary.get("files") or {}
    files = []
    for fn in meta["files"]:
        p = d / safe_name(fn)
        text = ""
        if p.exists():
            try:
                text = p.read_text(errors="replace")
            except OSError:
                text = ""
        lines = text.splitlines()
        files.append({
            "name": fn,
            "summary": file_summaries.get(fn) or None,
            "path": str(p),
            "teaser": "\n".join(lines[:PREVIEW_TEASER_LINES]),
            "more_lines": max(0, len(lines) - PREVIEW_TEASER_LINES),
        })
    state = load_state()
    if summary.get("summary"):
        status = "ready"
    elif state.get("apple_llm_status") == "unavailable":
        status = "unavailable"
    elif summary.get("_unparsed"):
        status = "failed"       # the model produced nothing usable; retried weekly
    else:
        status = "pending"
    return {
        "id": meta["id"],
        "description": meta["description"],
        "updated_at": meta["updated_at"],
        "html_url": meta["html_url"],
        "public": bool(meta.get("public")),
        "summary": summary.get("summary") or None,
        "summary_status": status,
        "summary_unavailable_reason": (state.get("apple_llm_reason") or "unknown reason")
        if status == "unavailable" else None,
        "files": files,
    }


def preview(gist_id, as_json=False):
    data = preview_data(gist_id)
    if as_json:
        if data is None:
            print(f"gistgrep: unknown id {gist_id}", file=sys.stderr)
            sys.exit(1)
        print(json.dumps(data, ensure_ascii=False))
        return
    if data is None:
        print(f"(no cached data for {gist_id})")
        return
    desc = data["description"] or "(no description)"
    marker = "public" if data["public"] else "🔒 secret"
    print(f"\033[1m{desc}\033[0m")
    print(f"{data['updated_at'][:10]}  ·  {marker}")
    print(f"{data['html_url']}")
    print("─" * 60)

    if data["summary"]:
        print(f"\033[32m✦ {data['summary']}\033[0m")
        print()

    # When we have a summary: just list files with their one-liner purpose, no body dump.
    # When we don't: show a short teaser (~20 lines) so the user has something concrete
    # while the background worker catches up.
    for f in data["files"]:
        if f["summary"]:
            print(f"\033[36m▸ {f['name']}\033[0m  \033[2m— {f['summary']}\033[0m")
        else:
            print(f"\033[36m▸ {f['name']}\033[0m")
        if not data["summary"] and f["teaser"].strip():
            print(f["teaser"])
            if f["more_lines"]:
                print(f"\033[2m… ({f['more_lines']} more lines)\033[0m")
        print()

    # Footer: subtle warning if Apple Intelligence summaries aren't available
    if data["summary_status"] == "unavailable":
        reason = data["summary_unavailable_reason"]
        print(f"\033[2m⚠ no on-device summaries — Apple Intelligence unavailable ({reason})\033[0m")
    elif data["summary_status"] == "failed":
        print("\033[2m⚠ no summary — the on-device model produced nothing usable (retried weekly)\033[0m")
    elif data["summary_status"] == "pending":
        print("\033[2m⋯ summary pending (generating in background)\033[0m")


def open_in_browser(gist_id):
    d = GISTS / gist_id
    meta_file = d / "_meta.json"
    if not meta_file.exists():
        print(f"gistgrep: unknown id {gist_id}", file=sys.stderr)
        sys.exit(1)
    meta = json.loads(meta_file.read_text())
    url = meta["html_url"]
    opener = "open" if sys.platform == "darwin" else "xdg-open"
    subprocess.run([opener, url])


def print_url(gist_id):
    d = GISTS / gist_id
    meta_file = d / "_meta.json"
    if meta_file.exists():
        print(json.loads(meta_file.read_text())["html_url"], end="")


def edit_local(gist_id):
    d = GISTS / gist_id
    meta_file = d / "_meta.json"
    if not meta_file.exists():
        return
    meta = json.loads(meta_file.read_text())
    editor = os.environ.get("EDITOR", "vi")
    files = [str(d / safe_name(fn)) for fn in meta["files"] if (d / safe_name(fn)).exists()]
    if files:
        subprocess.run([editor] + files)


def main():
    ap = argparse.ArgumentParser(
        description="Fast local search over your GitHub gists."
    )
    ap.add_argument("query", nargs="*", help="search term(s)")
    ap.add_argument("--sync", action="store_true", help="force full resync")
    ap.add_argument("--no-sync", action="store_true",
                    help="search the cache only: no network, no gh, no background jobs")
    ap.add_argument("--sync-only", action="store_true",
                    help="bring the cache up to date, then exit (non-zero on failure)")
    ap.add_argument("--limit", type=int, default=200)
    ap.add_argument("--plain", action="store_true", help="plain-text output, no TUI")
    ap.add_argument("--json", action="store_true",
                    help="JSON output for search results, --preview and --sync-only")
    ap.add_argument("--reconcile", action="store_true", help=argparse.SUPPRESS)
    ap.add_argument("--preview", metavar="ID", help=argparse.SUPPRESS)
    ap.add_argument("--open", metavar="ID", dest="open_id", help=argparse.SUPPRESS)
    ap.add_argument("--url", metavar="ID", help=argparse.SUPPRESS)
    ap.add_argument("--edit", metavar="ID", help=argparse.SUPPRESS)
    ap.add_argument("--summarize-queue", action="store_true", help=argparse.SUPPRESS)
    ap.add_argument("--summarize", metavar="ID", help="summarize one gist now (foreground)")
    ap.add_argument("--check-llm", action="store_true", help="probe Apple Intelligence availability")
    ap.add_argument("--refetch-content", action="store_true", help="re-fetch file contents for all cached gists (fixes empty files)")
    ap.add_argument("--doctor", action="store_true", help="check dependencies and cache status")
    ap.add_argument("--version", action="version", version="gistgrep 0.3.0")
    args = ap.parse_args()

    CACHE.mkdir(parents=True, exist_ok=True)
    GISTS.mkdir(parents=True, exist_ok=True)

    # Hard-stop: gh is non-negotiable for any operation that talks to GitHub.
    # Internal subcommands and --no-sync searches only read the local cache, so
    # they don't need it (and skip the ~0.4s `gh auth status` round trip).
    internal = (
        args.doctor
        or args.preview
        or args.open_id
        or args.url
        or args.edit
        or args.reconcile
        or args.summarize_queue
        or args.summarize
        or args.check_llm
    )
    talks_to_github = args.sync or args.sync_only or args.refetch_content or not args.no_sync
    needs_gh = talks_to_github and not internal
    if needs_gh:
        ok_gh, msg_gh = gh_available()
        if not ok_gh:
            print(f"gistgrep: {msg_gh}", file=sys.stderr)
            print("Run `gistgrep --doctor` for a full check.", file=sys.stderr)
            sys.exit(1)

    if args.doctor:
        doctor()
        return
    if args.reconcile:
        do_reconcile()
        return
    if args.preview:
        preview(args.preview, as_json=args.json)
        return
    if args.open_id:
        open_in_browser(args.open_id)
        return
    if args.url:
        print_url(args.url)
        return
    if args.edit:
        edit_local(args.edit)
        return
    if args.summarize_queue:
        summarize_queue()
        return
    if args.summarize:
        state = load_state()
        ok, reason = ensure_apple_llm(state)
        if not ok:
            print(f"Apple Intelligence unavailable: {reason}", file=sys.stderr)
            sys.exit(1)
        try:
            summarize_gist(args.summarize)
        except LLMUnavailable as e:
            mark_llm_unavailable(load_state(), str(e))
            print(f"Apple Intelligence unavailable: {e}", file=sys.stderr)
            sys.exit(1)
        return
    if args.refetch_content:
        # Walk every cached gist, re-fetch its canonical record so file contents populate.
        if not GISTS.exists():
            return
        ids = [d.name for d in GISTS.iterdir() if (d / "_meta.json").exists()]
        print(f"gistgrep: re-fetching content for {len(ids)} gists…", file=sys.stderr)
        from concurrent.futures import ThreadPoolExecutor
        def fetch_one(gid):
            try:
                g = gh_api(f"/gists/{gid}")
                # also wipe stale summary since content is about to change
                s = GISTS / gid / "_summary.json"
                if s.exists():
                    s.unlink()
                save_gist(g)
                return True
            except Exception as e:
                print(f"  warn: {gid}: {e}", file=sys.stderr)
                return False
        ok = 0
        with ThreadPoolExecutor(max_workers=8) as ex:
            for i, res in enumerate(ex.map(fetch_one, ids), 1):
                if res:
                    ok += 1
                if i % 50 == 0:
                    print(f"  {i}/{len(ids)}…", file=sys.stderr)
        print(f"gistgrep: refetched {ok}/{len(ids)} gists.", file=sys.stderr)
        return
    if args.check_llm:
        state = load_state()
        forget_llm_status(state)        # force a re-check
        ok, reason = ensure_apple_llm(state)
        if ok:
            summarize_bg()
            print("Apple Intelligence: available — writing any missing summaries in the background")
        else:
            print(f"Apple Intelligence: unavailable — {reason}")
        return

    state = load_state()
    query = " ".join(args.query).strip()

    # --sync-only: for callers that sync once and then search with --no-sync
    # (a launcher searching on every keystroke). Failure must be loud.
    if args.sync_only:
        try:
            msg = sync_now(state, full=args.sync)
        except subprocess.CalledProcessError as e:
            detail = (e.stderr or str(e)).strip()
            print(f"gistgrep: sync failed: {detail}", file=sys.stderr)
            sys.exit(1)
        start_upkeep(state)
        if args.json:
            print(json.dumps({"ok": True, "message": msg,
                              "last_updated_at": state.get("last_updated_at")}))
        elif msg:
            print(f"gistgrep: {msg}", file=sys.stderr)
        return

    # Sync with transient status line + Esc-to-skip. If the user cancels,
    # we fall through to searching whatever's already cached.
    if args.sync or not args.no_sync:
        msg = "↻ Full sync…  (Esc to skip)" if args.sync else "↻ Checking for new gists…  (Esc to skip)"
        if state.get("last_updated_at") is None:
            msg = "↻ First run — initial sync (one-time, ~30s)…  (Esc to skip)"
        try:
            with SyncStatus(msg):
                sync_now(state, full=args.sync)
        except Cancelled:
            pass
        except subprocess.CalledProcessError as e:
            if not CANCELLED.is_set():
                print(f"gistgrep: sync failed: {(e.stderr or str(e)).strip()}", file=sys.stderr)
        start_upkeep(state)

    # With no query, show everything (most recent first); otherwise ranked results.
    results = search(query, args.limit) if query else recent(args.limit)

    if args.json:
        fmt_json(results, query)
        return

    interactive = (
        not args.plain
        and sys.stdout.isatty()
        and fzf_available()
    )
    if interactive:
        tui(results, initial_query=query)
    else:
        if not args.plain and not fzf_available() and sys.stdout.isatty():
            print("gistgrep: fzf not found — falling back to plain output. Install with: brew install fzf", file=sys.stderr)
        fmt_plain(results)


if __name__ == "__main__":
    main()
